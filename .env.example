VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Razorpay
VITE_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=

# Google Drive / Maps Integration
VITE_GOOGLE_API_KEY=

# Main app domain, if not gather.link
VITE_APP_DOMAIN=

# Feature flags ("true"/"false"); see utils/featureFlags.ts
VITE_FEATURE_AGENCY=false
VITE_FEATURE_AB_TESTING=false
VITE_FEATURE_RAZORPAY=true
VITE_FEATURE_STRIPE=false
VITE_FEATURE_CASHFREE=false

# Server-only (never prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=
RESEND_FROM_EMAIL=
NEXT_PUBLIC_APP_URL=https://gather.link

# Clicks are stored directly by api/r. Set CLICK_QUEUE=qstash to queue them
# through QStash instead (process-click rejects requests without the signing keys).
CLICK_QUEUE=
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Secret used to HMAC visitor IPs before storing them. Copy it from Supabase
# Vault (secret "ip_hash_salt"); use the same value for the track-click edge
# function's IP_HASH_SALT secret.
IP_HASH_SALT=

# Vercel KV (redirect cache) — set automatically when KV is linked in Vercel
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI (server-only)
GEMINI_API_KEY=
JINA_API_KEY=

# Protects /api/cron/cleanup
CRON_SECRET=

# Parked providers: server endpoints stay off unless these are "true"
ENABLE_STRIPE=false
ENABLE_CASHFREE=false
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
